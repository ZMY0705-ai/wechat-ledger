# ── 依赖 ──────────────────────────────────────────────────────────────
node_modules/

# ── 账本与本机状态：绝对不能进版本库 ─────────────────────────────────
#   ledger.db           你的真实账目（每一笔都在里面）
#   backup/             VACUUM 出来的快照
#   chat-memory.json    陪聊记住的事
#   weixin-context.json 微信会话上下文
#   bridge-drafts.json  还没确认的半截草稿
#   logs/               运行日志（可能含消息原文）
data/

# 万一库文件落在别处，也一并兜住
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── 密钥：微信 bot token、各家 LLM 的 API key ─────────────────────────
#   .env 是唯一存放密钥的地方，示例文件 .env.example 可以提交
.env
*.env
!.env.example

# ── 日志 ──────────────────────────────────────────────────────────────
*.log
*.log.err
*.log.prev

# ── 编辑器 / 系统 ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db