# 微信 iLink Bot token —— 跑 `npm run login` 扫码后拿到
WEIXIN_BOT_TOKEN=

# 只接受这个用户 ID 发来的消息（留空 = 不限制，任何人给 bot 发消息都会记账）
# 跑 `npm run login` 时会把 ilink_user_id 打印出来，复制到这里，多个用逗号分隔
WEIXIN_ALLOWED_USER_IDS=

# ── LLM 供应商（二选一，与 config/bridge.json 里的 llm.provider 对应）──
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 智谱 GLM: https://open.bigmodel.cn
GLM_API_KEY=

# 记账服务地址（M0 完成后才有用）
LEDGER_BASE_URL=http://127.0.0.1:8787

# ── 陪聊（可选）──
# 陪聊和记账共用上面这个 bot、这个 token、这个进程，配置在 config/bridge.json 的 chat 段。
# 这两个只是逃生开关，平时不用填：
#   CHAT_ENABLED=0            临时关掉陪聊，行为立刻回到「只用记账」
#   CHAT_LLM_MODEL=xxx        只给聊天换模型（比如换免费的 glm-4.7-flash），不动配置文件